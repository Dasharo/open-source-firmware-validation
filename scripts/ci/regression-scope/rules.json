{
    "rules": [
        {
            "name": "Run changed test suites",
            "on-changed": "dasharo-[a-z]{,15}/(.*)",
            "run": [
                {
                    "env_vars": {
                        "ASSET_ID": "00039",
                        "RTE_IP": "192.168.10.199",
                        "SNIPEIT_NO": "true",
                        "CONFIG": "msi-pro-z690-a-wifi-ddr4",
                        "SONOFF_IP": "192.168.10.169",
                        "PIKVM_IP": "192.168.10.120"
                    },
                    "files": {
                        "mode": "${FULL_FILENAME_MATCH}"
                    }
                },
                {
                    "env_vars": {
                        "ASSET_ID": "00252",
                        "RTE_IP": "192.168.10.171",
                        "SNIPEIT_NO": "true",
                        "CONFIG": "pcengines-apu3",
                        "FW_FILE": "~/actions-runner/osfv-test-binaries/pcengines_apu3_v0.9.1-rc2.rom"
                    },
                    "files": {
                        "mode": "${FULL_FILENAME_MATCH}"
                    }
                }
            ]
        },
        {
            "name": "Run suites that use a modified lib",
            "on-changed": "lib/(.*)",
            "run": [
                {
                    "env_vars": {
                        "ASSET_ID": "00039",
                        "RTE_IP": "192.168.10.199",
                        "SNIPEIT_NO": "true",
                        "CONFIG": "msi-pro-z690-a-wifi-ddr4",
                        "SONOFF_IP": "192.168.10.169",
                        "PIKVM_IP": "192.168.10.120"
                    },
                    "files": {
                        "mode": "${FILE_CONTAINS_MATCH}",
                        "search_in": ["dasharo-compatibility", "dasharo-security", "dasharo-performance", "dasharo-stability"]
                    }
                },
                {
                    "env_vars": {
                        "ASSET_ID": "00252",
                        "RTE_IP": "192.168.10.171",
                        "SNIPEIT_NO": "true",
                        "CONFIG": "pcengines-apu3"
                    },
                    "files": {
                        "mode": "${FILE_CONTAINS_MATCH}",
                        "search_in": ["dasharo-compatibility", "dasharo-security", "dasharo-performance", "dasharo-stability"]
                    }
                }
            ]
        }
    ]
}
