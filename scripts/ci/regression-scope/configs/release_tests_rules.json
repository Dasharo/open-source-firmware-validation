{
    "rules": [
        {
            "name": "Run changed test suites",
            "on-changed": "[a-z\\-\\/]*([^\\n\\.\\/]+\\.robot)",
            "run": {
                "files": {
                    "mode": "${FULL_FILENAME_MATCH}"
                },
                "robot_args": "-i automated"
            }
        }
    ]
}
